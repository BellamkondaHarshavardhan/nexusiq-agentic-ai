# =====================================================================
#  NexusIQ configuration.  Copy this file to ".env" and fill in ONE option.
#  With no keys at all the app still runs in OFFLINE DEMO mode.
# =====================================================================

# auto = Azure if configured, else OpenAI if configured, else offline demo
# values: auto | azure | openai | offline
LLM_PROVIDER=auto

# values: auto | azure | openai | offline   (offline = local hashing embeddings, no API needed)
EMBEDDING_PROVIDER=auto

# ---- Option A: Azure OpenAI -----------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=          # your chat model deployment name, e.g. gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=     # your embedding deployment name, e.g. text-embedding-3-small

# ---- Option B: OpenAI (or any OpenAI-compatible endpoint) -------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Leave empty for OpenAI. For other OpenAI-compatible servers (Groq, Ollama, ...) put their base URL here,
# and set EMBEDDING_PROVIDER=offline if that server has no embeddings endpoint.
OPENAI_BASE_URL=

# ---- Observability: LangSmith tracing (optional) ----------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexusiq

# ---- Tuning (optional) -----------------------------------------------
# 0 = deterministic. Use 'default' for models that only accept their own default temperature.
LLM_TEMPERATURE=0
RETRIEVAL_TOP_K=4
SQL_MAX_ROWS=50
SQL_MAX_RETRIES=2
CRITIC_MAX_RETRIES=1
